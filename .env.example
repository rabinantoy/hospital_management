# Environment variables template for CarePulse Hospital Management System

# Application Port
PORT=3000
NODE_ENV=development

# PostgreSQL Database Connection URL (Prisma ORM)
DATABASE_URL="postgresql://carepulse_admin:SecurePass2026@localhost:5432/carepulse_db?schema=public"

# JWT Authentication Secret Key
JWT_SECRET="super_secret_jwt_key_carepulse_2026"
JWT_EXPIRES_IN="7d"

# Hospital Center Details
HOSPITAL_NAME="CarePulse Regional Hospital"
HOSPITAL_UHID_PREFIX="CP-2026-"
HOSPITAL_TAX_RATE=0.05

# App Host URL
APP_URL="http://localhost:3000"
